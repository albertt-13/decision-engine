NODE_ENV=development
PORT=4100

# Postgres (Recommendation, SystemConfig)
DATABASE_URL=postgresql://decision:decision_dev@127.0.0.1:5434/decision_db

# MongoDB (SalesSnapshot)
MONGODB_URL=mongodb://127.0.0.1:27019/decision_engine

# Redis (guardrail de rate limit en modo live)
REDIS_URL=redis://127.0.0.1:6381

# Auth propia del operador (un solo rol, sin multi-tenant)
JWT_SECRET=changeme
OPERATOR_EMAIL=operador@decision-engine.local
# bcrypt hash de la password del operador - generar con: node -e "console.log(require('bcrypt').hashSync('tu-password', 12))"
OPERATOR_PASSWORD_HASH=changeme

# OrderFlow como fuente de datos externa (cliente HTTP, sin credenciales por ahora - solo endpoints publicos)
ORDERFLOW_BASE_URL=https://orderflow-api-gateway-my23.onrender.com

# AI Analyst (M5) - LLMClient tiene dos adapters intercambiables, elegis con LLM_PROVIDER
LLM_PROVIDER=anthropic
# console.anthropic.com -> API Keys (requiere credito cargado)
ANTHROPIC_API_KEY=changeme
# console.groq.com/keys - tier gratis, sin tarjeta (usar con LLM_PROVIDER=groq)
GROQ_API_KEY=changeme

# Pipeline de agregacion
AGGREGATION_CRON_SCHEDULE=*/10 * * * *

# Insight Engine (M5) - corre despues del pipeline, por defecto una vez por dia
INSIGHTS_CRON_SCHEDULE=0 6 * * *

# Guardrail: maximo de recomendaciones ejecutadas (modo live) por hora
LIVE_MODE_MAX_PER_HOUR=20

# Whitelist de CORS para el dashboard React, separada por comas. Vacio = nadie
CORS_ORIGINS=http://localhost:5173
