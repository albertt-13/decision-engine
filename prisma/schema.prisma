generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recommendation {
  id            String    @id @default(uuid()) @db.Uuid
  targetRef     String
  ruleTriggered String
  reason        String
  mode          Mode      @default(SHADOW)
  executedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([mode])
  @@index([createdAt])
}

enum Mode {
  SHADOW
  LIVE
}

model SystemConfig {
  key   String @id
  value String
}

model Insight {
  id          String   @id @default(uuid()) @db.Uuid
  content     String
  generatedBy String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
